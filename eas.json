      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": true
      }
    },
    "qa": {
      "distribution": "internal",
      "channel": "qa",
      "android": {
        "buildType": "apk"
      }
    },
    "field-production": {
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
